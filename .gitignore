# Environments
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data and caches (never committed; see README for acquisition)
data/
cache/
results/raw/
results/experiments/*.npz
# per-run CSV statistics ARE committed: they are what regenerates
# every table and figure in the article without re-running inference.
*.npz
*.npy
*.pt
*.pth

# OS
.DS_Store

# LaTeX build artifacts
*.aux
*.log
*.out

# Locally trained checkpoints (large; never committed). The per-model
# config.json (architecture, normalisation, split digests) is committed so
# that the provenance checks of the audit can run without the weights.
checkpoints/*
!checkpoints/*/
checkpoints/*/*
!checkpoints/*/config.json

# Run logs and the machine-specific environment snapshot
*.log
results/environment_report.txt

# Retired artifacts kept outside the published tree
_to_delete/

# Written by scripts/write_revision.sh for non-git copies of the tree
REVISION
